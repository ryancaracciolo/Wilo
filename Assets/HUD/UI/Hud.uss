.hud-root {
    flex-grow: 1;
    font-size: 15px;
    color: rgb(76, 61, 47);
    -unity-font-style: bold;
}

.hud-top-left {
    position: absolute;
    left: 18px;
    top: 16px;
    flex-direction: row;
    align-items: center;
}

.hud-stat-chip {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin-right: 10px;
    padding: 0 14px 0 12px;
    border-radius: 22px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
}

.hud-stat-glyph {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    flex-shrink: 0;
}

.hud-stat-value {
    font-size: 16px;
    color: rgb(76, 61, 47);
    -unity-font-style: bold;
}

.hud-top-right {
    position: absolute;
    right: 18px;
    top: 16px;
}

.hud-bottom {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 16px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.hud-icon-button {
    width: 58px;
    height: 58px;
    margin-right: 10px;
    padding: 0;
    border-radius: 29px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
    overflow: hidden;
}

.hud-icon-button:hover {
    background-color: rgb(255, 252, 245);
    scale: 1.04;
}

.hud-icon-button > .unity-button__text,
.hud-lure-chip > .unity-button__text,
.hud-lure-option > .unity-button__text,
.hud-tourney-chip > .unity-button__text {
    display: none;
}

.hud-icon-glyph {
    flex-grow: 1;
    margin: 8px;
}

.hud-gadget {
    width: 248px;
    height: 248px;
    padding: 8px;
    border-radius: 22px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
    flex-direction: column;
    overflow: hidden;
}

.hud-tab-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 6px;
    background-color: rgb(244, 226, 198);
    border-radius: 14px;
    padding: 3px;
}

.hud-tab {
    flex-grow: 1;
    height: 26px;
    margin: 0 2px;
    padding: 0;
    border-radius: 11px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(122, 98, 74);
    font-size: 13px;
    -unity-font-style: bold;
}

.hud-tab--on {
    background-color: rgb(78, 156, 148);
    color: rgb(255, 248, 236);
}

.hud-map {
    flex-grow: 1;
    border-radius: 14px;
    overflow: hidden;
    background-color: rgb(91, 175, 190);
}

.hud-map-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-map-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.004);
}

.hud-map-journal {
    flex-direction: row;
    width: 860px;
    height: 540px;
    padding: 16px;
    border-radius: 24px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
}

.hud-map-journal-map {
    flex-grow: 1;
    margin-right: 16px;
    border-radius: 16px;
    overflow: hidden;
    min-width: 420px;
    background-color: rgb(91, 175, 190);
}

.hud-map-journal-map > .hud-map {
    height: 100%;
}

.hud-map-journal-detail {
    width: 268px;
    padding: 2px 4px 8px 4px;
    overflow: hidden;
    flex-shrink: 0;
}

.hud-map-journal-detail > .hud-card-header {
    flex-shrink: 0;
}

.hud-map-journal-detail > .hud-muted {
    flex-shrink: 0;
}

.hud-mark-list {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 8px;
}

.hud-mark-facts {
    flex-shrink: 0;
    padding-top: 8px;
    border-top-width: 2px;
    border-top-color: rgb(244, 226, 198);
}

.hud-mark-facts > .hud-title {
    font-size: 18px;
}

.hud-map-journal-detail .hud-text-button {
    flex-shrink: 0;
    background-color: rgb(244, 226, 198);
}

.hud-map-journal-detail .hud-name-field {
    margin-top: 8px;
}

.hud-map-journal-detail .hud-form-actions {
    flex-wrap: wrap;
    margin-top: 10px;
}

.hud-mark-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    margin-bottom: 4px;
    padding: 0 8px;
    border-radius: 12px;
    border-width: 0;
    background-color: rgb(244, 226, 198);
    color: rgb(76, 61, 47);
    font-size: 13px;
    -unity-font-style: bold;
}

.hud-mark-row--on {
    background-color: rgb(78, 156, 148);
    color: rgb(255, 248, 236);
}

.hud-mark-row > .hud-lure-swatch {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    border-radius: 6px;
    flex-shrink: 0;
}

.hud-mark-row > .hud-body {
    margin-bottom: 0;
    font-size: 12px;
    -unity-font-style: bold;
}

.hud-mark-row--on > .hud-body {
    color: rgb(255, 248, 236);
}

.hud-sonar-wrap {
    flex-grow: 1;
    overflow: hidden;
}

.hud-sonar {
    flex-grow: 1;
    border-radius: 12px;
    overflow: hidden;
}

.hud-sonar-depth {
    position: absolute;
    right: 14px;
    bottom: 14px;
    color: rgb(255, 248, 236);
    font-size: 13px;
}

.hud-strip {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 16px;
    border-radius: 26px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
}

.hud-weather-glyph {
    width: 28px;
    height: 28px;
    margin-right: 6px;
}

.hud-strip-label {
    font-size: 14px;
    color: rgb(76, 61, 47);
    -unity-font-style: bold;
    margin: 0 2px;
}

.hud-strip-date {
    font-size: 13px;
    color: rgb(138, 116, 96);
    margin-left: 8px;
}

.hud-strip-dot {
    width: 5px;
    height: 5px;
    margin: 0 8px;
    border-radius: 3px;
    background-color: rgb(212, 180, 131);
}

.hud-lure-chip {
    flex-direction: row;
    align-items: center;
    height: 56px;
    min-width: 108px;
    margin-left: 12px;
    padding: 0 14px 0 8px;
    border-radius: 28px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
}

.hud-lure-chip:hover {
    background-color: rgb(255, 252, 245);
}

.hud-lure-swatch {
    width: 40px;
    height: 40px;
    margin-right: 8px;
    flex-shrink: 0;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(76, 61, 47);
    background-color: rgb(244, 226, 198);
    -unity-background-scale-mode: scale-to-fit;
}

.hud-lure-swatch--photo {
    background-color: rgb(244, 226, 198);
}

.hud-lure-name {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.hud-lure-copy {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    overflow: hidden;
}

.hud-lure-hint {
    height: 28px;
    margin-top: 1px;
    font-size: 11px;
    color: rgb(138, 116, 96);
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    white-space: normal;
    overflow: hidden;
}

.hud-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(76, 61, 47, 0.28);
    align-items: center;
    justify-content: center;
}

.hud-card {
    flex-direction: column;
    width: 420px;
    max-height: 600px;
    padding: 22px 24px 20px 24px;
    border-radius: 24px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
    overflow: hidden;
}

.hud-card--prize {
    border-color: rgb(224, 178, 96);
}

.hud-card--tall {
    height: 600px;
}

.hud-card--standings {
    width: 720px;
    max-height: 600px;
}

.hud-card-header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.hud-card-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.hud-card-body .unity-scroll-view__vertical-scroller {
    width: 10px;
    margin-left: 6px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.hud-card-body .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.hud-card-body .unity-base-slider__dragger {
    width: 8px;
    margin-left: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: rgb(212, 180, 131);
}

.hud-card-body .unity-scroller__low-button,
.hud-card-body .unity-scroller__high-button {
    display: none;
}

.hud-title {
    flex-shrink: 0;
    font-size: 22px;
    color: rgb(76, 61, 47);
    -unity-font-style: bold;
}

/* Labels keep their height: squeezed rows would draw their text over each other. */
.hud-body {
    flex-shrink: 0;
    font-size: 15px;
    color: rgb(76, 61, 47);
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: normal;
}

.hud-muted {
    flex-shrink: 0;
    font-size: 13px;
    color: rgb(138, 116, 96);
    -unity-font-style: bold;
    margin-bottom: 10px;
    white-space: normal;
}

.hud-pill {
    flex-shrink: 0;
    margin-left: 6px;
    padding: 2px 9px;
    border-radius: 10px;
    background-color: rgb(255, 248, 236);
    color: rgb(138, 116, 96);
    font-size: 11px;
    -unity-font-style: bold;
}

.hud-pill--on {
    background-color: rgb(78, 156, 148);
    color: rgb(255, 248, 236);
}

.hud-close {
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(244, 226, 198);
    font-size: 16px;
}

.hud-section {
    flex-shrink: 0;
    margin-top: 8px;
    margin-bottom: 6px;
    padding: 12px 14px;
    border-radius: 16px;
    background-color: rgb(244, 226, 198);
}

.hud-profile-hero {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.hud-profile-avatar {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    padding: 10px;
    border-radius: 32px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 252, 245);
    flex-shrink: 0;
}

.hud-profile-identity {
    flex-grow: 1;
    flex-shrink: 1;
}

.hud-profile-name {
    font-size: 24px;
    margin-bottom: 0;
}

.hud-profile-identity > .hud-muted {
    margin-bottom: 0;
    margin-top: 2px;
}

.hud-text-button--quiet {
    height: 28px;
    margin-top: 0;
    margin-left: 8px;
    padding: 0 10px;
    background-color: rgb(244, 226, 198);
    font-size: 12px;
}

.hud-profile-hero > .hud-text-button {
    margin-top: 0;
    margin-left: 8px;
}

.hud-profile-stats {
    flex-direction: row;
    margin-bottom: 4px;
    margin-right: -8px;
}

.hud-profile-stat {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 8px;
    padding: 10px 12px 8px 12px;
    border-radius: 16px;
    background-color: rgb(244, 226, 198);
}

.hud-profile-stat-glyph {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    flex-shrink: 0;
}

.hud-profile-stat-value {
    font-size: 22px;
    margin-bottom: 0;
}

.hud-profile-stat-label {
    margin-top: 2px;
    margin-bottom: 0;
}

.hud-profile-best > .hud-muted {
    margin-bottom: 4px;
}

.hud-profile-best-mark {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    flex-shrink: 0;
}

.hud-profile-best-weight {
    font-size: 28px;
    color: rgb(196, 140, 48);
    margin-bottom: 0;
}

.hud-profile-best > .hud-body {
    margin-bottom: 0;
}

.hud-profile-section-head {
    margin-bottom: 4px;
}

.hud-profile-section-title {
    flex-grow: 1;
    margin-bottom: 0;
}

.hud-profile-result {
    margin-top: 6px;
    padding: 8px 10px;
    border-radius: 12px;
    background-color: rgb(255, 248, 236);
}

.hud-profile-result-name {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 0;
    font-size: 14px;
}

.hud-profile-result > .hud-muted {
    margin-top: 2px;
    margin-bottom: 0;
}

/* Heading a run of rows, such as a weekend or, later, a series. */
.hud-group-label {
    margin-top: 14px;
    margin-bottom: 0;
    margin-left: 2px;
    font-size: 12px;
}

.hud-card-tabs {
    margin-bottom: 10px;
    flex-shrink: 0;
}

.hud-past-filter {
    margin-bottom: 8px;
    flex-shrink: 0;
}

.hud-lock-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 2px;
}

.hud-lock-glyph {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    flex-shrink: 0;
}

.hud-lock-label {
    margin-bottom: 0;
}

.hud-prize {
    align-items: center;
    padding: 8px 0 4px 0;
}

.hud-prize-mark {
    width: 64px;
    height: 64px;
    margin-bottom: 6px;
}

.hud-prize-place {
    margin-bottom: 4px;
    font-size: 28px;
    color: rgb(196, 140, 48);
    -unity-text-align: middle-center;
}

.hud-prize > .hud-body {
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.hud-prize-haul {
    align-items: center;
    width: 100%;
    margin-top: 4px;
    margin-bottom: 8px;
    padding: 12px 16px 10px 16px;
    border-radius: 16px;
    background-color: rgb(255, 244, 220);
}

.hud-prize-money {
    margin-bottom: 2px;
    font-size: 30px;
    color: rgb(76, 61, 47);
    -unity-text-align: middle-center;
}

.hud-prize-rep {
    margin-bottom: 0;
    font-size: 16px;
    color: rgb(78, 156, 148);
    -unity-text-align: middle-center;
}

.hud-tourney-row {
    margin-top: 6px;
    margin-bottom: 8px;
    padding: 10px 12px 8px 12px;
}

.hud-tourney-row--entered {
    border-width: 2px;
    border-color: rgb(78, 156, 148);
}

.hud-tourney-row--placed {
    border-width: 2px;
    border-color: rgb(224, 178, 96);
}

.hud-tourney-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.hud-tourney-name {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 0;
    font-size: 16px;
}

.hud-tourney-row > .hud-muted {
    margin-bottom: 1px;
}

.hud-tourney-actions {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 2px;
}

.hud-tourney-actions > .hud-text-button {
    height: 28px;
    margin-top: 6px;
    margin-right: 8px;
}

.hud-text-button {
    flex-shrink: 0;
    height: 32px;
    margin-top: 8px;
    padding: 0 14px;
    border-radius: 16px;
    border-width: 0;
    background-color: rgb(255, 248, 236);
    color: rgb(76, 61, 47);
    font-size: 13px;
    -unity-font-style: bold;
}

.hud-text-button--primary {
    background-color: rgb(78, 156, 148);
    color: rgb(255, 248, 236);
}

.hud-text-button:hover {
    background-color: rgb(244, 226, 198);
}

.hud-text-button:active {
    background-color: rgb(226, 198, 158);
}

.hud-text-button--primary:hover {
    background-color: rgb(96, 174, 166);
}

.hud-text-button--primary:active {
    background-color: rgb(54, 126, 120);
}

.hud-name-field {
    margin: 6px 0 2px 0;
}

.hud-name-field .unity-base-text-field__input {
    height: 38px;
    padding: 0 12px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
    color: rgb(76, 61, 47);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    align-items: center;
    justify-content: center;
}

.hud-name-field #unity-text-input,
.hud-name-field .unity-text-element {
    flex-grow: 1;
    height: 100%;
    min-height: 22px;
    -unity-text-align: middle-left;
}

.hud-name-field .unity-base-text-field__input:focus {
    border-color: rgb(78, 156, 148);
}

.hud-form-actions {
    flex-direction: row;
    margin-top: 6px;
    /* UI Toolkit has no :last-child, so the row absorbs the trailing gutter. */
    margin-right: -8px;
}

.hud-form-actions > .hud-text-button {
    flex-grow: 1;
    margin-top: 8px;
    margin-right: 8px;
}

.hud-popover-catcher {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-lure-popover {
    position: absolute;
    flex-direction: column;
    width: 300px;
    min-height: 0;
    padding: 12px;
    border-radius: 18px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
    overflow: hidden;
}

.hud-lure-popover > .hud-muted {
    flex-shrink: 0;
    margin-bottom: 6px;
}

.hud-lure-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.hud-lure-list .unity-scroll-view__vertical-scroller {
    width: 10px;
    margin-left: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.hud-lure-list .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.hud-lure-list .unity-base-slider__dragger {
    width: 8px;
    margin-left: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: rgb(212, 180, 131);
}

.hud-lure-list .unity-scroller__low-button,
.hud-lure-list .unity-scroller__high-button {
    display: none;
}

.hud-lure-option {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 70px;
    min-height: 70px;
    margin-bottom: 6px;
    padding: 8px 10px;
    border-radius: 12px;
    border-width: 0;
    background-color: rgb(244, 226, 198);
}

.hud-lure-option--on {
    background-color: rgb(78, 156, 148);
    color: rgb(255, 248, 236);
}

.hud-lure-option--on .hud-lure-hint {
    color: rgba(255, 248, 236, 0.82);
}

.hud-row {
    flex-direction: row;
    align-items: center;
}

.hud-catch-toast {
    position: absolute;
    left: 50%;
    top: 18%;
    translate: -50% 0;
    padding: 12px 22px;
    border-radius: 18px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
    font-size: 20px;
    color: rgb(76, 61, 47);
    -unity-font-style: bold;
}

.hud-notice-toast {
    position: absolute;
    left: 50%;
    top: 9%;
    translate: -50% 0;
    padding: 9px 20px;
    border-radius: 16px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
    font-size: 15px;
    color: rgb(76, 61, 47);
    -unity-font-style: bold;
    white-space: normal;
    max-width: 460px;
    -unity-text-align: middle-center;
}

.hud-tourney-chip {
    position: absolute;
    left: 50%;
    top: 2%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 6px 10px 6px 16px;
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(224, 178, 96);
    background-color: rgb(255, 250, 238);
}

.hud-tourney-chip:hover {
    background-color: rgb(255, 252, 245);
}

.hud-tourney-chip-label {
    font-size: 14px;
    color: rgb(76, 61, 47);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-right: 8px;
}

.hud-tourney-chevron {
    width: 22px;
    height: 22px;
    padding: 3px;
    border-radius: 11px;
    background-color: rgb(224, 178, 96);
    flex-shrink: 0;
}

.hud-tourney-chevron--open {
    rotate: 180deg;
}

.hud-bag-popover {
    position: absolute;
    width: 280px;
    padding: 12px;
    border-radius: 18px;
    border-width: 3px;
    border-color: rgb(224, 178, 96);
    background-color: rgb(255, 250, 238);
}

.hud-bag-popover > .hud-muted {
    margin-bottom: 6px;
}

.hud-bag-row {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    margin-bottom: 2px;
}

.hud-bag-name {
    flex-grow: 1;
    margin-bottom: 0;
    font-size: 14px;
}

.hud-standings {
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 8px;
    padding: 6px;
    border-radius: 16px;
    background-color: rgb(244, 226, 198);
}

.hud-standings-row {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    padding: 2px 6px;
    border-radius: 8px;
}

.hud-standings-row--head {
    margin-bottom: 4px;
}

.hud-standings-row--head > .hud-standings-cell {
    color: rgb(138, 116, 96);
    font-size: 11px;
}

.hud-standings-row--player {
    background-color: rgb(255, 248, 236);
}

.hud-standings-cell {
    font-size: 13px;
    color: rgb(76, 61, 47);
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-bottom: 0;
}

.hud-standings-place {
    width: 28px;
    flex-shrink: 0;
}

.hud-standings-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
}

.hud-standings-fish {
    width: 40px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.hud-standings-weight {
    width: 62px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.hud-standings-lunker {
    width: 58px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.hud-standings-lunker--won {
    color: rgb(196, 140, 48);
}

.hud-prize-haul > .hud-muted {
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.hud-cues {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-cue {
    position: absolute;
}

.hud-cue--action {
    flex-direction: row;
    align-items: center;
    padding: 3px 9px 3px 3px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
}

.hud-cue--action:hover {
    background-color: rgb(255, 252, 245);
}

.hud-cue-key {
    min-width: 24px;
    height: 24px;
    padding: 0 5px;
    margin-right: 6px;
    border-radius: 7px;
    border-width: 1px;
    border-color: rgb(196, 164, 118);
    background-color: rgb(255, 252, 245);
    font-size: 12px;
    color: rgb(76, 61, 47);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-cue-label {
    font-size: 13px;
    color: rgb(76, 61, 47);
    -unity-font-style: bold;
}

.hud-cue--alert {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.hud-cue-bang {
    font-size: 68px;
    color: rgb(237, 97, 82);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(76, 61, 47);
}

.hud-fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(12, 10, 16);
}

.hud-summary {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.hud-summary-card {
    width: 440px;
    max-height: 620px;
    padding: 26px 26px 22px 26px;
    border-radius: 26px;
    border-width: 3px;
    border-color: rgb(224, 178, 96);
    background-color: rgb(255, 248, 236);
}

.hud-summary-card > .hud-row {
    justify-content: center;
    margin-top: 6px;
}

.hud-catch-sheet {
    position: absolute;
    left: 22px;
    top: 92px;
    width: 292px;
    padding: 18px 20px 16px 20px;
    border-radius: 22px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
}

.hud-catch-catcher {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-catch-size {
    font-size: 18px;
    margin-bottom: 10px;
}

.hud-catch-lure {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.hud-catch-lure > .hud-body {
    margin-bottom: 0;
}

.hud-catch-actions {
    flex-direction: row;
    margin-top: 6px;
    /* UI Toolkit has no :last-child, so the row absorbs the trailing gutter. */
    margin-right: -8px;
}

.hud-catch-actions > .hud-text-button {
    flex-grow: 1;
    margin-top: 8px;
    margin-right: 8px;
}

.hud-fight {
    position: absolute;
    right: 22px;
    top: 278px;
    width: 92px;
    height: 340px;
    flex-direction: column;
    padding: 10px 8px 22px 8px;
    border-radius: 22px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
}

.hud-fight-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

.hud-fight-meter {
    width: 12px;
    margin-right: 8px;
    border-radius: 8px;
    background-color: rgb(244, 226, 198);
    overflow: hidden;
}

.hud-fight-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 8px;
    background-color: rgb(107, 199, 122);
}

.hud-fight-fill--hot {
    background-color: rgb(140, 219, 102);
}

.hud-fight-track {
    flex-grow: 1;
    border-radius: 16px;
    background-color: rgb(126, 196, 206);
    overflow: hidden;
}

.hud-fight-bar {
    position: absolute;
    left: 5px;
    right: 5px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(212, 180, 131);
    background-color: rgba(255, 248, 236, 0.78);
}

.hud-fight-fish {
    position: absolute;
    left: 4px;
    right: 4px;
}

.hud-fight-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 16px;
    font-size: 11px;
    color: rgb(138, 116, 96);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.hud-lure-depth {
    position: absolute;
    right: 22px;
    top: 278px;
    width: 78px;
    height: 300px;
    flex-direction: column;
    align-items: stretch;
    padding: 8px 8px 8px 8px;
    border-radius: 22px;
    border-width: 3px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
}

.hud-lure-depth-title {
    height: 14px;
    font-size: 11px;
    color: rgb(138, 116, 96);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.hud-lure-depth-readout {
    height: 20px;
    font-size: 15px;
    color: rgb(77, 61, 46);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.hud-lure-depth-column {
    flex-grow: 1;
    margin: 4px 6px 4px 6px;
    border-radius: 10px;
    overflow: hidden;
}

.hud-lure-depth-marker {
    position: absolute;
    left: 0;
    right: 0;
    height: 14px;
}

.hud-lure-depth-marker--down {
    opacity: 0.55;
}

.hud-lure-depth-bed {
    height: 14px;
    font-size: 11px;
    color: rgb(138, 116, 96);
    -unity-text-align: middle-center;
}

.hud-intro {
    flex-direction: row;
    align-items: stretch;
}

.hud-intro-card {
    width: 440px;
    max-width: 42%;
    max-height: none;
    margin: 24px 0 24px 24px;
}

.hud-intro-scroll {
    flex-grow: 1;
}

.hud-intro-title {
    font-size: 32px;
    margin-bottom: 6px;
    white-space: normal;
}

.hud-intro-lead {
    font-size: 14px;
    margin-bottom: 16px;
    color: rgb(122, 98, 74);
}

.hud-intro-kicker {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(122, 98, 74);
    margin-bottom: 8px;
}

.hud-intro-section {
    padding: 14px 16px;
}

.hud-intro-stage {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 28px;
}

.hud-intro-wash {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 33.333%;
    background-color: rgba(255, 248, 236, 0.16);
}

.hud-intro-hint {
    margin-bottom: 0;
    padding: 6px 14px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(212, 180, 131);
    background-color: rgba(255, 248, 236, 0.88);
    color: rgb(76, 61, 47);
}

.hud-intro-soon {
    margin-top: 4px;
    margin-bottom: 0;
    color: rgb(176, 96, 72);
}

.hud-choice-row {
    flex-wrap: wrap;
    margin-right: -8px;
}

.hud-choice {
    height: 34px;
    margin: 0 8px 8px 0;
    padding: 0 14px;
    border-radius: 17px;
    border-width: 2px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
    color: rgb(76, 61, 47);
    font-size: 13px;
    -unity-font-style: bold;
}

.hud-choice--on {
    background-color: rgb(78, 156, 148);
    border-color: rgb(78, 156, 148);
    color: rgb(255, 248, 236);
}

.hud-choice:hover {
    background-color: rgb(244, 226, 198);
}

.hud-choice:active {
    background-color: rgb(226, 198, 158);
}

.hud-choice--on:hover {
    background-color: rgb(96, 174, 166);
}

.hud-choice--on:active {
    background-color: rgb(54, 126, 120);
}

.hud-choice--locked {
    opacity: 0.72;
}

.hud-swatch-block {
    margin-top: 4px;
}

.hud-swatch-label {
    margin-bottom: 4px;
}

.hud-swatch-row {
    flex-wrap: wrap;
}

.hud-swatch {
    width: 32px;
    height: 32px;
    margin: 0 7px 7px 0;
    padding: 3px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(212, 180, 131);
    background-color: rgb(255, 248, 236);
}

.hud-swatch--on {
    border-color: rgb(78, 156, 148);
    background-color: rgb(78, 156, 148);
}

.hud-swatch-fill {
    flex-grow: 1;
    border-radius: 12px;
}

.hud-swatch > .unity-button__text {
    display: none;
}

.hud-lake-slot {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
    padding: 12px 14px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(226, 198, 158);
    background-color: rgb(255, 248, 236);
}

.hud-lake-slot-text {
    flex-grow: 1;
    margin-right: 10px;
}

.hud-lake-slot-name {
    font-size: 16px;
    margin-bottom: 0;
}

.hud-lake-slot .hud-muted {
    margin-bottom: 0;
}

.hud-lake-slot > .hud-text-button {
    margin-top: 0;
}
